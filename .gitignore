# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep the example template tracked
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# preaudit runtime state and generated workbooks
/data/state/*.json
/data/state/*.tmp
/data/exports/
/.worktrees/
/.playwright-cli/
/.superpowers/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# data state - ensure entire directory is ignored
/data/state/

# templates uploaded by users
/data/templates/*.xlsx
/data/templates/*.xls
!data/templates/preaudit-2025-11.xlsx
